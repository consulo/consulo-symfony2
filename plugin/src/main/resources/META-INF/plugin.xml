<consulo-plugin url="https://github.com/consulo/consulo-symfony2">
    <id>fr.adrienbrault.idea.symfony2plugin</id>
    <name>Symfony Support</name>
    <description>Support for Symfony framework and components: services, routing, Twig templates, Doctrine, forms, translations</description>
    <vendor>Daniel Espendiller &amp; consulo.io</vendor>
    <depends>consulo.php</depends>
    <depends>consulo.twig</depends>
    <depends>com.intellij.xml</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>consulo.json</depends>
    <depends>consulo.javascript</depends>
    <depends>de.espend.idea.php.annotation</depends>
    <depends>de.espend.idea.php.toolbox</depends>
    <depends optional="true">consulo.markdown</depends>
    <depends optional="true">consulo.database</depends>
    <version>SNAPSHOT</version>
    <category>Framework Integration</category>

    <tags>
        <tag>framework</tag>
    </tags>
</consulo-plugin>
